{
  "manifest_version": 3,
  "name": "RTL Everywhere",
  "version": "1.0.0",
  "description": "راست‌چین کردن صفحات وب با یک کلیک",
  "permissions": ["storage", "activeTab", "scripting"],
  "action": {
    "default_title": "تغییر راست‌چین/چپ‌چین"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["src/rtl.css"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "options_page": "options.html"
}
